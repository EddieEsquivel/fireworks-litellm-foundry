# Copy to .env only for unattended setup. Interactive setup creates this file.
# Never commit .env. Values use JSON string quoting; this is NOT a shell script.
# Paste the complete HTTPS OpenAI v1 base from your Foundry deployment's sample.
FOUNDRY_API_BASE=""
FOUNDRY_API_KEY=""
# Optional single deployment override for ALL Claude models, including background
# requests. Keep its actual value only in ignored .env next to your API key.
FOUNDRY_MODEL=""
# Legacy per-role mappings; only required if FOUNDRY_MODEL is empty.
# Exact deployment names, not Fireworks catalog paths. All three may be identical.
FOUNDRY_SONNET_DEPLOYMENT=""
FOUNDRY_OPUS_DEPLOYMENT=""
FOUNDRY_HAIKU_DEPLOYMENT=""
# Full local HTTP base URL: loopback host + an explicit unused port; no path.
LITELLM_PROXY_BASE_URL=""
# Leave empty on first setup to generate a random proxy-only sk- key.
LITELLM_MASTER_KEY=""
